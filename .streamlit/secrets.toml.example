# Copy this file to `.streamlit/secrets.toml` for local runs, OR paste its
# contents into Streamlit Community Cloud → app → Settings → Secrets.
# Do NOT commit the real secrets.toml (it is gitignored).
#
# The values come from a Google Cloud *service account* JSON key. Create one at
# console.cloud.google.com (enable the Google Sheets API), download the JSON,
# then copy each field below. Finally, share your Google Sheet with the
# service account's client_email address, giving it Editor access.

[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Keep the literal \n escapes inside the quotes:
private_key = "-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"
client_email = "survey-writer@your-project-id.iam.gserviceaccount.com"
client_id = "000000000000000000000"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/survey-writer%40your-project-id.iam.gserviceaccount.com"

[sheet]
# Create an empty Google Sheet, share it with client_email (Editor), and paste
# its URL here. The "responses" worksheet/header are created automatically.
url = "https://docs.google.com/spreadsheets/d/REPLACE_WITH_SHEET_ID/edit"
worksheet = "responses"

# --- Recruitment platforms (optional) ---------------------------------------
# Completion codes shown on the final page. Each block is optional; a code that
# is absent (or blank) simply isn't shown. These can also be filled in directly
# at the top of app.py if you'd rather not use secrets.

[prolific]
completion_code = "REPLACE_WITH_PROLIFIC_COMPLETION_CODE"

[recruitment]
# From surveyswap.io — the code participants enter there, and optionally the
# redirect link SurveySwap gives you (https://surveyswap.io/sr/<your-id>).
surveyswap_code = "REPLACE_WITH_SURVEYSWAP_CODE"
surveyswap_url = "https://surveyswap.io/sr/REPLACE_ME"
# From surveycircle.com — the survey code (XXXX-XXXX-XXXX-XXXX) participants
# enter there, and optionally a link back to the site.
surveycircle_code = "REPLACE_WITH_SURVEYCIRCLE_CODE"
surveycircle_url = "https://www.surveycircle.com/"
